post_install() {
	vlicense LICENSE
	vlicense "${wrksrc}/glaze-7.2.0/LICENSE" glaze-LICENSE
	sed -e "s|^Name=.*|Name=Abyssland (D-Bus)|" -e "s|^Exec=.*|Exec=dbus-run-session /usr/bin/start-abyssland|" \
		"${DESTDIR}/usr/share/wayland-sessions/abyssland.desktop" \
		> "${DESTDIR}/usr/share/wayland-sessions/abyssland-dbus.desktop"
}
